# Copy to .env.local for local testing. Do not commit real values.
# Booking emails send through Resend.
RESEND_API_KEY=
RESEND_FROM=Snapper Marine Charters <bookings@snappermarinecharters.com>
# Notification inbox (defaults to this address if unset)
BOOKING_NOTIFY_TO=jbarnes@snappermarinecharters.com
# Optional booking alert webhook. Leave unset until you have a URL and auth value.
# Authorization is sent as the full header value in BOOKING_ALERT_WEBHOOK_AUTH.
BOOKING_ALERT_WEBHOOK_URL=
BOOKING_ALERT_WEBHOOK_AUTH=
